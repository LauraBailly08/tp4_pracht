---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Étape 2 - Simple Penguin">
  <div class="space-y-6">
    <div class="border-b border-slate-200 pb-4">
      <h1 class="text-3xl font-bold text-slate-800">Étape 2 : Simple Penguin (Client-side)</h1>
      <p class="text-slate-600 mt-1">
        Affichage du nuage de points des manchots (Palmers Penguins) généré côté client via l'import de <code>penguins.json</code>.
      </p>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h2 class="text-lg font-semibold text-slate-700 mb-4">Nuage de points des Manchots :</h2>
      <div id="penguin-plot" class="flex justify-center p-4 bg-slate-50 rounded-lg overflow-x-auto min-h-[360px] items-center"></div>
    </div>

    <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-lg text-sm text-amber-900 space-y-1">
      <p class="font-semibold">💡 Points techniques mis en œuvre :</p>
      <ul class="list-disc list-inside space-y-1">
        <li>Importation du fichier JSON de données directement dans le script client : <code>import penguins from "../assets/penguins.json";</code></li>
        <li>Création d'un <code>Plot.dot</code> avec les dimensions <em>culmen_length_mm</em> (axe X) et <em>culmen_depth_mm</em> (axe Y).</li>
        <li>Coloration par espèce avec légende activée (<code>color: &#123; legend: true &#125;</code>).</li>
      </ul>
    </div>
  </div>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import penguins from "../assets/penguins.json";

  // Création du graphique des manchots côté client
  const plot = Plot.plot({
    title: "Dimensions du bec selon l'espèce de manchot",
    subtitle: "Dataset Palmer Penguins (Culmen Length vs Culmen Depth)",
    grid: true,
    color: {
      legend: true,
    },
    x: {
      label: "Longueur du bec (mm) →",
    },
    y: {
      label: "↑ Profondeur du bec (mm)",
    },
    marks: [
      Plot.dot(penguins, {
        x: "culmen_length_mm",
        y: "culmen_depth_mm",
        stroke: "species",
        tip: true,
      }),
    ],
  });

  // Sélection du conteneur et ajout du graphique au DOM
  const div = document.querySelector("#penguin-plot");
  div?.append(plot);
</script>

